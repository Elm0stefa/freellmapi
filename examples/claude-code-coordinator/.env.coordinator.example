# Env template for a SECOND, DEDICATED FreeLLMAPI instance used as the
# "coordinator's" MCP backend (Claude Code delegating to free specialist
# models). Copy this file to a separate working copy of the repo as
# `.env` — do NOT merge it into the main instance's `.env`, and do NOT
# reuse the main instance's database file or encryption key.
#
# See docs/mobile-dev-hub/04-claude-code-coordinator.md for the full setup
# walkthrough and docs/mobile-dev-hub/03-glixel.md ("Two servers on one
# database") for why these must stay separate.

# Generate a fresh key for THIS instance only. Never copy the main
# instance's key here, and never commit the real value anywhere.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate-a-new-64-char-hex-key-for-this-instance

# Pick a port that does not collide with the main instance (commonly 3001).
PORT=3002

# Keep this instance localhost-only. Do not set HOST_BIND=0.0.0.0 for the
# coordinator's backend — it has no reason to be reachable from other
# devices, and GLIXEL/mobile access is a separate, later decision.
HOST=127.0.0.1

# Its own SQLite file, never the main instance's.
FREEAPI_DB_PATH=/absolute/path/to/a/new/freellmapi-coordinator.db

# --- Free-only routing: keep this ON for the coordinator's instance ---
# Default is already "on" when unset; set it explicitly so it's obvious
# in this file. Do NOT set this to "off" for the coordinator's instance —
# that disables the guard entirely and allows paid/credit-based/unverified
# providers into automatic routing.
FREE_ONLY_ROUTING=on

# Do NOT uncomment this for the coordinator's instance. Opting a platform
# in here makes it eligible for AUTOMATIC routing too, i.e. an ordinary
# delegated request could land on a paid or credit-based provider without
# asking first. Leave it unset.
# FREE_ONLY_ALLOW_PLATFORMS=custom,sail

# Default model for the MCP `ask_freellmapi` tool when a caller omits
# `model`; each tool call may still override it.
MCP_INFERENCE_DEFAULT_MODEL=auto

# Timeout (ms) for the `ask_freellmapi` MCP tool, 1,000-300,000.
MCP_INFERENCE_TIMEOUT_MS=120000
